{
  "config": {
    "step": {
      "user": {
        "title": "Eufy Clean account",
        "description": "Sign in with the account you use in the Eufy Clean / eufy app. All robots on the account are added.",
        "data": {
          "username": "Email",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate",
        "description": "The password for {username} was rejected. Enter the current password.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Login was rejected. Check the email and password.",
      "cannot_connect": "Could not reach the Eufy cloud (it rate-limits logins; wait a few minutes and try again).",
      "no_robot": "No MQTT-capable robot vacuum is bound to this account.",
      "unknown": "Unexpected error; see the log."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "reauth_successful": "Re-authentication succeeded."
    }
  },
  "services": {
    "start_scene": {
      "name": "Start scene",
      "description": "Start one of the cleaning scenes defined in the Eufy app.",
      "fields": {
        "scene_id": {
          "name": "Scene ID",
          "description": "Numeric scene id (see the vacuum's scenes attribute)."
        },
        "scene_name": {
          "name": "Scene name",
          "description": "Scene name as shown in the app."
        }
      }
    },
    "start_rooms": {
      "name": "Clean rooms",
      "description": "Clean specific rooms of a map.",
      "fields": {
        "room_ids": {
          "name": "Room IDs",
          "description": "List of room ids in cleaning order."
        },
        "map_id": {
          "name": "Map ID",
          "description": "Id of the map the rooms belong to."
        }
      }
    }
  },
  "entity": {
    "vacuum": {
      "robot": {
        "state_attributes": {
          "fan_speed": {
